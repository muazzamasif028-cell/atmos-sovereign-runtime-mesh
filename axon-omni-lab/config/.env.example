# ============================================================================
# AXON OMNI LAB — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Service Ports (optional — defaults shown) ─────────────────────────────────
PORT=3000                    # face-service (dashboard + API gateway)
BRAIN_PORT=3001
HANDS_PORT=3002
VOICE_PORT=3003
CONSCIOUSNESS_PORT=3004
WISDOM_PORT=3005
REFLEXES_PORT=3006
NERVOUS_PORT=3007
GROWTH_PORT=3008
SKELETON_PORT=3009
SKIN_PORT=3010
DNA_PORT=3011
GATEWAY_PORT=4000

# ── Service URLs (for inter-service communication) ────────────────────────────
# In production on Zeabur, these will be internal service URLs
BRAIN_SERVICE_URL=http://localhost:3001
HANDS_SERVICE_URL=http://localhost:3002
VOICE_SERVICE_URL=http://localhost:3003
CONSCIOUSNESS_SERVICE_URL=http://localhost:3004
WISDOM_SERVICE_URL=http://localhost:3005
REFLEXES_SERVICE_URL=http://localhost:3006
NERVOUS_SYSTEM_URL=http://localhost:3007
GROWTH_SERVICE_URL=http://localhost:3008
SKELETON_SERVICE_URL=http://localhost:3009
SKIN_SERVICE_URL=http://localhost:3010
DNA_SERVICE_URL=http://localhost:3011

# ── Database (Element 3: DNA) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/axon_omni_lab
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=true
RUN_MIGRATIONS=false

# ── Redis (Element 10: Nervous System) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_PREFIX=axon:

# ── AI Models (Element 4: Brain) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
DEFAULT_AI_MODEL=deepseek-chat
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# ── Vector Database (Element 7: Wisdom) ──────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_URL=https://my-index-xxx.svc.pinecone.io
PINECONE_ENVIRONMENT=us-east-1-aws
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Cloudflare (Element 2: Skin) ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...
CLOUDFLARE_ACCOUNT_ID=...

# ── Stripe (Element 8: Hands) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Slack (Element 8: Hands) ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# ── Gmail (Element 8: Hands) ──────────────────────────────────────────────────
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...

# ── GitHub (Element 8: Hands) ─────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=...

# ── Zapier (Element 8: Hands) ─────────────────────────────────────────────────
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=24h
API_KEYS=key1,key2,key3
REQUIRE_API_KEY=false
ALLOWED_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Zeabur Deployment ─────────────────────────────────────────────────────────
ZEABUR_REGION=auto
DEPLOY_TIME=
